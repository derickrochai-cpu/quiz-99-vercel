{
  "version": 2,
  "routes": [
    { "src": "/api/coupons/(.*)", "dest": "/api/coupons/$1.js" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/(.+)", "dest": "/$1" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Player-Id" }
      ]
    }
  ]
}
